# System Settings
PROJECT_NAME=SmartQ
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smartq_admin
POSTGRES_PASSWORD=smartq_secret_password
POSTGRES_DB=smartq_db
DATABASE_URL=postgresql+asyncpg://smartq_admin:smartq_secret_password@localhost:5432/smartq_db

# Redis Cache & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security / Auth
SECRET_KEY=super_secret_jwt_key_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI & LLM Integration
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Push Notifications (FCM)
FIREBASE_CREDENTIALS_PATH=./backend/app/core/firebase_credentials.json

# Service Endpoints
BACKEND_URL=http://localhost:8000
WEBSITE_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8001
CHATBOT_SERVICE_URL=http://localhost:8002
